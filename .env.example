# Enables the Gemini analysis route (create a key in Google AI Studio). Without it, the app uses the rule-based dossier.
GEMINI_API_KEY=
# Optional model override. Confirm the ID against the models your key can use (default: gemini-3.5-flash).
GEMINI_MODEL=
# Signing secret for POST /api/webhooks/stripe (the route returns 503 without it).
STRIPE_WEBHOOK_SECRET=
