{
  "mcpServers": {
    "foundry-image": {
      "command": "sh",
      "args": [
        "-c",
        "[ -x tools/foundry-image-mcp/node_modules/.bin/tsx ] || npm ci --prefix tools/foundry-image-mcp --no-audit --no-fund --loglevel=error >&2; exec tools/foundry-image-mcp/node_modules/.bin/tsx tools/foundry-image-mcp/server.ts"
      ],
      "env": {
        "FOUNDRY_ENDPOINT": "${FOUNDRY_ENDPOINT}",
        "FOUNDRY_API_KEY": "${FOUNDRY_API_KEY}",
        "FOUNDRY_IMAGE_DEPLOYMENT": "${FOUNDRY_IMAGE_DEPLOYMENT}",
        "FOUNDRY_API_VERSION": "${FOUNDRY_API_VERSION:-}",
        "NODE_USE_ENV_PROXY": "1"
      }
    }
  }
}
